Generated code preview: def isEscapePossible(blocked, source, target):     def find_path(source, target):         queue = collections.deque([(source, [])])         visited = {tuple(source)}         while queue:             node, path = queue.popleft()             if node == target:                 return path + [node]             for direction in [(0, -1), (0, 1), (-1, 0), (1, 0)]:                 new_node = (node[0] + direction[0], node[1] + direction[1])                 if (0 <= new_node[0] < 10**6) and (0 <= new_node[1] < 10**6) and new_node not in visited and new_node not in blocked:                     queue.append((new_node, path + [node]))                     visited.add(new_node)         return []      path1 = find_path(source, target)     path2 = find_path(target, source)     return path1 and path2
