Generated code preview: class Solution:     def search(self, nums: List[int], target: int) -> int:         if not nums:             return -1          left, right = 0, len(nums) - 1          while left <= right:             mid = left + (right - left) // 2              if nums[mid] == target:                 return mid              if nums[mid] >= nums[left]:                 if target >= nums[left] and target < nums[mid]:                     right = mid - 1                 else:                     left = mid + 1             else:                 if target <= nums[right] and target > nums[mid]:                     left = mid + 1                 else:                     right = mid - 1          return -1
