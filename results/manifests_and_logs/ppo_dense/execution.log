Generated code preview: class Solution:     def minInteger(self, num: str, k: int) -> str:         # 使用最大堆         from heapq import *         # 当前数字为0         curr = 0         # 统计非零数字的个数         count = collections.Counter(num)         if count[num[0]] == len(num):             return num         else:             count[num[0]] -= 1         heap = [(-v, num[i]) for i, v in enumerate(map(int, num))]         heapify(heap)         ans = []         while heap:             v, digit = heappop(heap)             if curr + len(ans) > k:                 ans = ans[:k-curr]                 v, digit = heappushpop(heap, (v, digit))                 curr -= len(ans)             ans.append(digit)             count[digit] -= 1             if count[digit] == 0:                 curr += len(ans)         return ''.join(ans)
