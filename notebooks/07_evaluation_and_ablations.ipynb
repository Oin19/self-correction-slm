   "source": [
    "# 07 — Comprehensive Evaluation & Scientific Ablation Studies (1.3B)\n",
    "**Goal**: Execute the complete evaluation matrix across **Zero-Shot Base, SFT, PPO-Dense, PPO-Binary, and DPO** for `deepseek-ai/deepseek-coder-1.3b-instruct` and answer all research questions:\n",
    "- **RQ1**: Can SLMs do agentic debugging ($K=1, 3, 5$) vs. repeated sampling (`F0`)?\n",
    "- **RQ2**: Does real execution feedback (`F2`/`F3`) outperform no feedback (`F0`), status-only (`F1`), and random fake feedback?\n",
    "- **RQ3**: Does RL (PPO/DPO) beat SFT and zero-shot baselines in `Pass@1`, `Fix@K`, and `ConditionalRepair@K`?\n",
    "- **RQ4**: Do SLMs benefit from dense partial-credit rewards (`ppo_dense`) vs. binary pass/fail rewards (`ppo_binary`)?\n",
    "- **RQ5**: Is DPO (`dpo`) competitive with PPO in multi-turn repair performance and efficiency?\n",
    "- **RQ6**: At what turn count $K \in \{1, 3, 5, 7\}$ does debugging performance plateau?\n",
    "- **RQ7**: Does training on APPS generalize out-of-distribution to HumanEval and MBPP?\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Setup, Universal Path Resolution & Harness Verification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip uninstall -y torchao\n",
    "!pip install -q trl peft bitsandbytes accelerate datasets transformers pandas\n",
    "\n",
    "import sys, os, shutil, importlib, json\n",
    "\n",
    "def prepare_environment_src():\n",
    "    curr = os.path.abspath(os.getcwd())\n",
    "    if os.path.exists(os.path.join(curr, 'src', 'models', 'loader.py')):\n",
    "        print(f\"Using local 'src' directory at {curr}\")\n",
    "        return curr\n",
    "    \n",
    "    parent = os.path.abspath('..')\n",
    "    if os.path.exists(os.path.join(parent, 'src', 'models', 'loader.py')):\n",
    "        print(f\"Using parent 'src' directory at {parent}\")\n",
    "        return parent\n",
    "\n",
    "    for colab_dir in ['/content/self-correction-slm', '/content/self-correction-llm-rl', '/content']:\n",
    "        if os.path.exists(os.path.join(colab_dir, 'src', 'models', 'loader.py')):\n",
    "            print(f\"Using Colab directory at {colab_dir}\")\n",
    "            return colab_dir\n",
    "    \n",
    "    if os.path.isdir('/kaggle/working'):\n",
    "        !rm -rf /kaggle/working/src\n",
    "        !git clone -b Rajdeep https://github.com/Oin19/self-correction-slm.git temp_repo || git clone https://github.com/Oin19/self-correction-slm.git temp_repo || git clone -b junior-A https://github.com/Oin19/self-correction-llm-rl.git temp_repo\n",
    "        if os.path.exists('temp_repo/src'):\n",
    "            shutil.copytree('temp_repo/src', '/kaggle/working/src')\n",
    "            !rm -rf temp_repo\n",
    "            print(\"Cloned latest 'src' from Rajdeep branch to /kaggle/working/src\")\n",
    "            return '/kaggle/working'\n",
    "\n",
    "    if os.path.exists('/kaggle/input'):\n",
    "        working_src = '/kaggle/working/src'\n",
    "        for root, dirs, files in os.walk('/kaggle/input'):\n",
    "            if 'models' in dirs and os.path.exists(os.path.join(root, 'models', 'loader.py')):\n",
    "                if os.path.exists(working_src):\n",
    "                    shutil.rmtree(working_src)\n",
    "                shutil.copytree(root, working_src)\n",
    "                print(f\"Copied 'src' from {root} to {working_src}\")\n",
    "                return '/kaggle/working'\n",
    "            elif 'src' in dirs and os.path.exists(os.path.join(root, 'src', 'models', 'loader.py')):\n",
    "                src_dir = os.path.join(root, 'src')\n",
    "                if os.path.exists(working_src):\n",
    "                    shutil.rmtree(working_src)\n",
    "                shutil.copytree(src_dir, working_src)\n",
    "                print(f\"Copied 'src' from {src_dir} to {working_src}\")\n",
    "                return '/kaggle/working'\n",
    "    return curr\n",
    "\n",
    "repo_root = prepare_environment_src()\n",
    "if repo_root not in sys.path:\n",
    "    sys.path.insert(0, repo_root)\n",
    "print(f\"Project path added: {repo_root}\")\n",
    "\n",
    "try:\n",
    "    import peft.import_utils\n",
    "    peft.import_utils.is_torchao_available = lambda: False\n",
    "except Exception:\n",
    "    pass\n",
    "try:\n",
    "    import peft.tuners.lora.torchao\n",
    "    peft.tuners.lora.torchao.is_torchao_available = lambda: False\n",
    "except Exception:\n",
    "    pass\n",
    "\n",
    "import torch\n",
    "import pandas as pd\n",
    "from datasets import load_dataset\n",
    "from peft import PeftModel\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
    "from src.models.loader import load_model_and_tokenizer\n",
    "from src.debugging.debug_loop import (\n",
    "    agentic_debug_loop,\n",
    "    agentic_loop_no_feedback,\n",
    "    agentic_loop_repeated_sampling,\n",
    ")\n",
    "from src.evaluation.metrics import (\n",
    "    evaluate,\n",
    "    calculate_pass_at_1,\n",
    "    calculate_fix_at_k,\n",
    "    calculate_error_distribution,\n",
    "    calculate_recovery_rate,\n",
    "    summarize_eval_metrics,\n",
    ")\n",
    "\n",
    "os.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n",
    "os.makedirs(\"./results\", exist_ok=True)\n",
    "\n",
    "print(\"Loading evaluation benchmarks (HumanEval & MBPP)...\")\n",
    "humaneval = load_dataset('openai_humaneval', split='test')\n",
    "mbpp = load_dataset('mbpp', split='test')\n",
    "\n",
    "print(f\"Loaded HumanEval: {len(humaneval)} test cases | MBPP: {len(mbpp)} test cases.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Main Evaluation Grid — Zero-Shot vs SFT vs PPO-Dense vs PPO-Binary vs DPO (RQ3, RQ4, RQ5, RQ7)\n",
    "Computes `Pass@1`, `Fix@1`, `Fix@3`, `Fix@5`, `ConditionalRepair@3`, and `ConditionalRepair@5` on HumanEval and MBPP across all 5 model arms (`Zero-Shot Base`, `SFT Baseline`, `PPO-Dense`, `PPO-Binary`, `DPO Model`) and saves per-problem JSONL traces plus `./results/final_evaluation_grid.csv`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "MODEL_NAME = \"deepseek-ai/deepseek-coder-1.3b-instruct\"\n",
    "EVAL_SLICE = 20  # Set to None to run full HumanEval (164) & MBPP (500)\n",
    "MAX_K = 5\n",
    "\n",
    "he_eval_ds = humaneval.select(range(min(EVAL_SLICE, len(humaneval)))) if EVAL_SLICE else humaneval\n",
    "mbpp_eval_ds = mbpp.select(range(min(EVAL_SLICE, len(mbpp)))) if EVAL_SLICE else mbpp\n",
    "\n",
    "def find_checkpoint(name_tags):\n",
    "    if isinstance(name_tags, str):\n",
    "        name_tags = [name_tags]\n",
    "    candidates = []\n",
    "    for name_tag in name_tags:\n",
    "        tag_l = name_tag.lower()\n",
    "        direct_paths = [\n",
    "            f\"./checkpoints/{name_tag}/final\",\n",
    "            f\"/kaggle/working/checkpoints/{name_tag}/final\",\n",
    "            f\"/content/checkpoints/{name_tag}/final\",\n",
    "            f\"/content/self-correction-slm/checkpoints/{name_tag}/final\",\n",
    "            f\"/content/self-correction-llm-rl/checkpoints/{name_tag}/final\",\n",
    "            f\"/content/drive/MyDrive/checkpoints/{name_tag}/final\",\n",
    "        ]\n",
    "        for p in direct_paths:\n",
    "            if os.path.exists(p) and (\n",
    "                os.path.exists(os.path.join(p, 'adapter_config.json'))\n",
    "                or os.path.exists(os.path.join(p, 'config.json'))\n",
    "            ):\n",
    "                return p\n",
    "        for search_root in ['./checkpoints', '/kaggle/working/checkpoints', '/kaggle/input']:\n",
    "            if not os.path.exists(search_root):\n",
    "                continue\n",
    "            for root, dirs, files in os.walk(search_root):\n",
    "                if 'adapter_config.json' in files or 'config.json' in files:\n",
    "                    rel_parts = [pt.lower() for pt in os.path.normpath(root).split(os.sep)[-3:]]\n",
    "                    if any(pt == tag_l or pt.startswith(tag_l) for pt in rel_parts):\n",
    "                        candidates.append(root)\n",
    "        if candidates:\n",
    "            break\n",
    "    if not candidates:\n",
    "        return None\n",
    "    final_cands = [c for c in candidates if os.path.basename(c).lower() == 'final']\n",
    "    return final_cands[0] if final_cands else sorted(candidates)[-1]\n",
    "\n",
    "def load_eval_model(checkpoint_path):\n",
    "    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)\n",
    "    if tokenizer.pad_token is None:\n",
    "        tokenizer.pad_token = tokenizer.eos_token\n",
    "    if checkpoint_path and os.path.exists(os.path.join(checkpoint_path, 'adapter_config.json')):\n",
    "        base_model = AutoModelForCausalLM.from_pretrained(\n",
    "            MODEL_NAME,\n",
    "            torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,\n",
    "            device_map=\"auto\" if torch.cuda.is_available() else None,\n",
    "            trust_remote_code=True,\n",
    "        )\n",
    "        model = PeftModel.from_pretrained(base_model, checkpoint_path, is_trainable=False)\n",
    "        print(f\"Loaded trained LoRA adapter from: {checkpoint_path}\")\n",
    "    else:\n",
    "        target = checkpoint_path if (checkpoint_path and os.path.exists(checkpoint_path)) else MODEL_NAME\n",
    "        model = AutoModelForCausalLM.from_pretrained(\n",
    "            target,\n",
    "            torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,\n",
    "            device_map=\"auto\" if torch.cuda.is_available() else None,\n",
    "            trust_remote_code=True,\n",
    "        )\n",
    "        print(f\"Loaded base/full model from: {target}\")\n",
    "    model.eval()\n",
    "    return model, tokenizer\n",
    "\n",
    "checkpoints_to_eval = [\n",
    "    (\"Zero-Shot Base\", MODEL_NAME),\n",
    "    (\"SFT Baseline\", find_checkpoint(\"sft\")),\n",
    "    (\"PPO-Dense Model\", find_checkpoint([\"ppo_dense\", \"ppo\"])),\n",
    "    (\"PPO-Binary Model\", find_checkpoint(\"ppo_binary\")),\n",
    "    (\"DPO Model\", find_checkpoint(\"dpo\")),\n",
    "]\n",
    "\n",
    "results_grid = []\n",
    "summary_by_model = {}\n",
    "\n",
    "for label, path in checkpoints_to_eval:\n",
    "    if label != \"Zero-Shot Base\" and not path:\n",
    "        print(f\"\\n[WARNING] Checkpoint for '{label}' not found in local/Kaggle paths — skipping so we do not falsely report Base Model numbers as '{label}'.\")\n",
    "        continue\n",
    "    print(f\"\\n================ Evaluating: {label} ({path}) ================\")\n",
    "    model, tokenizer = load_eval_model(path)\n",
    "    slug = label.lower().replace(\" \", \"_\").replace(\"-\", \"_\")\n",
    "\n",
    "    he_res = evaluate(\n",
    "        model, tokenizer, he_eval_ds, K=MAX_K,\n",
    "        label=f\"{label} HE\",\n",
    "        output_jsonl=f\"./results/{slug}_humaneval_k{MAX_K}.jsonl\",\n",
    "    )\n",
    "    mbpp_res = evaluate(\n",
    "        model, tokenizer, mbpp_eval_ds, K=MAX_K,\n",
    "        label=f\"{label} MBPP\",\n",
    "        output_jsonl=f\"./results/{slug}_mbpp_k{MAX_K}.jsonl\",\n",
    "    )\n",
    "    summary_by_model[label] = {\"he\": he_res, \"mbpp\": mbpp_res, \"path\": path}\n",
    "\n",
    "    for k in [1, 3, 5]:\n",
    "        results_grid.append({\n",
    "            \"Model\": label,\n",
    "            \"Checkpoint\": path,\n",
    "            \"K\": k,\n",
    "            \"HumanEval Pass@1\": f\"{he_res['pass_at_1']:.2%}\",\n",
    "            f\"HumanEval Fix@K\": f\"{he_res.get(f'fix_at_{k}', 0.0):.2%}\",\n",
    "            f\"HumanEval CondRepair@K\": f\"{he_res.get(f'conditional_repair_at_{k}', 0.0):.2%}\",\n",
    "            \"MBPP Pass@1\": f\"{mbpp_res['pass_at_1']:.2%}\",\n",
    "            f\"MBPP Fix@K\": f\"{mbpp_res.get(f'fix_at_{k}', 0.0):.2%}\",\n",
    "            f\"MBPP CondRepair@K\": f\"{mbpp_res.get(f'conditional_repair_at_{k}', 0.0):.2%}\",\n",
    "        })\n",
    "\n",
    "    del model\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "\n",
    "df_results = pd.DataFrame(results_grid)\n",
    "df_results.to_csv(\"./results/final_evaluation_grid.csv\", index=False)\n",
    "print(\"\\n================ AAAI Final Evaluation Grid Results ================\")\n",
    "print(df_results.to_string(index=False))\n",
    "print(\"\\nSaved full evaluation table to ./results/final_evaluation_grid.csv\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Scientific Ablations (RQ1/RQ2 Feedback Controls, RQ4 Dense vs Binary, RQ6 K-Turn Plateau)\n",
    "1. **RQ1 & RQ2 (Feedback Utility & Repeated-Sampling Control)**: Real execution feedback (`F2`) vs. No-feedback repeated sampling (`F0` / `B1`) vs. Status-only (`F1`) vs. Structured (`F3`) vs. Random fake error (`agentic_loop_no_feedback`)\n",
    "2. **RQ4 (Reward Granularity)**: Dense partial-test reward (`PPO-Dense`) vs. Binary pass/fail reward (`PPO-Binary`)\n",
    "3. **RQ6 (Turn Count Plateau)**: `Fix@K` and `ConditionalRepair@K` trajectory across $K \in \{1, 3, 5, 7\}$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Choose the best available trained checkpoint (DPO / PPO-Dense / SFT / Base) for ablations\n",
    "ablation_ckpt = (\n",
    "    find_checkpoint(\"dpo\")\n",
    "    or find_checkpoint([\"ppo_dense\", \"ppo\"])\n",
    "    or find_checkpoint(\"sft\")\n",
    "    or MODEL_NAME\n",
    ")\n",
    "print(f\"\\n--- Running Ablations using checkpoint: {ablation_ckpt} ---\")\n",
    "model, tokenizer = load_eval_model(ablation_ckpt)\n",
    "ablation_ds = humaneval.select(range(min(10, len(humaneval))))\n",
    "\n",
    "print(\"\\n--- 1. RQ1 & RQ2 Feedback Granularity & Repeated-Sampling Ablation (K=3) ---\")\n",
    "res_f0 = evaluate(\n",
    "    model, tokenizer, ablation_ds, K=3, label=\"F0 Repeated Sampling (No Feedback)\",\n",
    "    debug_loop_fn=agentic_loop_repeated_sampling,\n",
    "    output_jsonl=\"./results/ablation_f0_repeated_sampling.jsonl\",\n",
    ")\n",
    "res_f1 = evaluate(\n",
    "    model, tokenizer, ablation_ds, K=3, label=\"F1 Status-Only Feedback\",\n",
    "    debug_loop_fn=lambda m, t, p, tc, K=3: agentic_debug_loop(m, t, p, tc, K=K, feedback_mode=\"F1\"),\n",
    "    output_jsonl=\"./results/ablation_f1_status_only.jsonl\",\n",
    ")\n",
    "res_f2 = evaluate(\n",
    "    model, tokenizer, ablation_ds, K=3, label=\"F2 Sanitized Traceback Feedback\",\n",
    "    debug_loop_fn=lambda m, t, p, tc, K=3: agentic_debug_loop(m, t, p, tc, K=K, feedback_mode=\"F2\"),\n",
    "    output_jsonl=\"./results/ablation_f2_traceback.jsonl\",\n",
    ")\n",
    "res_f3 = evaluate(\n",
    "    model, tokenizer, ablation_ds, K=3, label=\"F3 Structured Feedback\",\n",
    "    debug_loop_fn=lambda m, t, p, tc, K=3: agentic_debug_loop(m, t, p, tc, K=K, feedback_mode=\"F3\"),\n",
    "    output_jsonl=\"./results/ablation_f3_structured.jsonl\",\n",
    ")\n",
    "res_fake = evaluate(\n",
    "    model, tokenizer, ablation_ds, K=3, label=\"Random Fake Error Feedback\",\n",
    "    debug_loop_fn=agentic_loop_no_feedback,\n",
    "    output_jsonl=\"./results/ablation_fake_feedback.jsonl\",\n",
    ")\n",
    "\n",
    "df_feedback = pd.DataFrame([\n",
    "    {\"Condition\": r[\"label\"], \"Pass@1\": f\"{r['pass_at_1']:.2%}\", \"Fix@3\": f\"{r['fix_at_3']:.2%}\", \"CondRepair@3\": f\"{r['conditional_repair_at_3']:.2%}\"}\n",
    "    for r in [res_f0, res_f1, res_f2, res_f3, res_fake]\n",
    "])\n",
    "df_feedback.to_csv(\"./results/ablation_feedback_modes.csv\", index=False)\n",
    "print(\"\\n=== Feedback Granularity Ablation Results (RQ1 & RQ2) ===\")\n",
    "print(df_feedback.to_string(index=False))\n",
    "\n",
    "print(\"\\n--- 2. RQ6 K-Turn Plateau Ablation (Single K=7 Rollout -> K=1, 3, 5, 7) ---\")\n",
    "res_k7 = evaluate(\n",
    "    model, tokenizer, ablation_ds, K=7, label=\"K=7 Trajectory\",\n",
    "    output_jsonl=\"./results/ablation_k7_trajectory.jsonl\",\n",
    ")\n",
    "k_rows = []\n",
    "for k_val in [1, 3, 5, 7]:\n",
    "    recs = res_k7[\"records\"]\n",
    "    total_n = len(recs)\n",
    "    init_fails = [r for r in recs if not r[\"pass_at_1\"]]\n",
    "    fix_k = sum(1 for r in recs if \"AC\" in r[\"statuses\"][:k_val]) / total_n if total_n else 0.0\n",
    "    cond_k = sum(1 for r in init_fails if \"AC\" in r[\"statuses\"][:k_val]) / len(init_fails) if init_fails else 0.0\n",
    "    k_rows.append({\"K\": k_val, \"Fix@K\": f\"{fix_k:.2%}\", \"ConditionalRepair@K\": f\"{cond_k:.2%}\"})\n",
    "\n",
    "df_k = pd.DataFrame(k_rows)\n",
    "df_k.to_csv(\"./results/ablation_k_plateau.csv\", index=False)\n",
    "print(\"\\n=== RQ6 K-Turn Trajectory Results ===\")\n",
    "print(df_k.to_string(index=False))\n",
    "\n",
    "print(\"\\nAll evaluation and ablation studies finished successfully! Artifacts saved in ./results/\")\n"
   ]
  }
 ],
